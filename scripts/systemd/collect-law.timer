# collect-law.service를 매달 1일 새벽 3시에 트리거.
# Persistent=true: WSL 종료/미기동 등으로 예정 시각을 놓쳐도,
# 다음 부팅 시 놓친 실행을 바로 따라잡아 실행함 (상시 켜진 서버가 아니므로 중요).

[Unit]
Description=매달 1회 법령 데이터 갱신 트리거 (collect-law.service)

[Timer]
OnCalendar=*-*-01 03:00:00
Persistent=true
Unit=collect-law.service

[Install]
WantedBy=timers.target
