# OpenSearch 3.7.0 (RAG_Mazelone) — 지금까지 nohup으로 수동 기동하던 걸 systemd로 전환.
#
# 확인된 전제조건 (2026-07-04 기준 이미 충족됨, 재확인만 하면 됨):
#   - vm.max_map_count=1048576 이 /etc/sysctl.d/10-map-count.conf 로 영구 설정되어 있음
#     (WSL 재부팅해도 sysctl.d 설정은 매번 다시 적용됨 — OpenSearch 부트스트랩 체크 통과 조건)
#   - /etc/wsl.conf 에 systemd=true 로 되어 있어 이 WSL 인스턴스에서 systemd 자체는 정상 동작 (ollama.service가 그 증거)
#
# 설치 (smt17 쉘, root 권한 필요):
#   sudo cp scripts/systemd/opensearch.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now opensearch.service
#
# 확인:
#   systemctl status opensearch.service
#   curl -sk -u admin:'Secure#Open2024!' https://localhost:9200
#   journalctl -u opensearch.service -n 50
#
# 주의: bin/opensearch를 -d(데몬화) 없이 foreground로 실행해야 systemd(Type=simple)가
# 프로세스를 제대로 추적/재시작 관리할 수 있습니다. 기존 nohup 방식과 달리
# 백그라운드로 fork하지 않습니다.

[Unit]
Description=OpenSearch 3.7.0 (RAG_Mazelone)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/smt17/opensearch/opensearch-3.7.0/bin/opensearch

[Service]
Type=simple
User=smt17
Group=smt17
WorkingDirectory=/home/smt17/opensearch/opensearch-3.7.0
ExecStart=/home/smt17/opensearch/opensearch-3.7.0/bin/opensearch
LimitNOFILE=1048576
LimitMEMLOCK=infinity
LimitNPROC=4096
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
